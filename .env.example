# Supabase — not required to run the mockup.
# Leave these unset and the app uses the in-memory mock adapter (src/lib/db/mock-adapter.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only for applying db/schema.sql and db/seed.sql.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
